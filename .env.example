# --- Claude API (required for AI parsing; without it the offline rules engine is used) ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-haiku-5-5 (fast, cheapest) | claude-sonnet-5-5 | claude-opus-5-5 (most accurate)
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional for models that support it: low | medium | high | xhigh | max
# CLAUDE_EFFORT=medium

# --- App ---
PORT=80
SUPPORT_MAILBOX=sap.helpdesk@company.in
# Shared secret for POST /api/inbound (send it as header x-inbound-token)
# INBOUND_TOKEN=change-me

# --- Optional: poll a real mailbox over IMAP ---
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=sap.helpdesk@company.in
# IMAP_PASS=app-password
# IMAP_FOLDER=INBOX
# IMAP_POLL_SECONDS=30

# Time zone used when telling Claude when an email arrived
APP_TIMEZONE=Asia/Kolkata

# Email an acknowledgement automatically when a ticket is created (replies on existing tickets stay drafts)
# AUTO_ACK=true

# --- Which mailbox reader to use: graph (Microsoft 365) | imap (GoDaddy, Gmail, cPanel…) | off ---
# MAIL_INBOUND=imap

# --- Example: GoDaddy mailbox ---
# SUPPORT_MAILBOX=support@yourdomain.com
# MAIL_INBOUND=imap
# EMAIL_IMAP_HOST=imap.secureserver.net
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=support@yourdomain.com
# EMAIL_IMAP_PASS=...
# EMAIL_HOST=smtpout.secureserver.net
# EMAIL_PORT=465
# EMAIL_USER=support@yourdomain.com
# EMAIL_PASS=...
# EMAIL_FROM="SAP Service Desk <support@yourdomain.com>"
# Friendly local address (map it to 127.0.0.1 in the Windows hosts file)
# APP_URL=http://sensaidesk.com
